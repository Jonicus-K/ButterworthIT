<!-- Client-side Global Search Data Matrix -->
<script>
    const allToolsData = [
        {% for tool in collections.tools %}
        {
            title: {{ tool.data.title | dump | safe }},
            url: {{ tool.url | dump | safe }},
            icon: {{ (tool.data.icon or '✨') | dump | safe }},
            category: {{ tool.data.category | dump | safe }},
            description: {{ (tool.data.description or '') | dump | safe }}
        }{% if not loop.last %},{% endif %}
        {% endfor %}
    ];

    document.addEventListener('DOMContentLoaded', () => {
        // Desktop Navbar Search Handler
        const navInput = document.getElementById('navSearchInput');
        const navDropdown = document.getElementById('navSearchResults');
        const navResultsList = document.getElementById('navResultsList');

        if (navInput && navDropdown && navResultsList) {
            navInput.addEventListener('input', (e) => {
                const q = e.target.value.trim().toLowerCase();
                if (!q) {
                    navDropdown.classList.add('hidden');
                    navResultsList.innerHTML = '';
                    return;
                }

                const matches = allToolsData.filter(t => 
                    t.title.toLowerCase().includes(q) || 
                    t.description.toLowerCase().includes(q)
                );

                if (matches.length === 0) {
                    navResultsList.innerHTML = '<div class="p-3 text-xs text-gray-500 dark:text-gray-400 text-center">No tools found matching "' + q + '"</div>';
                } else {
                    navResultsList.innerHTML = matches.map(t => `
                        <a href="${t.url}" class="flex items-center gap-2.5 p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700/70 transition-colors">
                            <span class="text-lg">${t.icon}</span>
                            <div class="overflow-hidden">
                                <div class="text-xs font-bold text-gray-900 dark:text-white truncate">${t.title}</div>
                                <div class="text-[11px] text-gray-500 dark:text-gray-400 truncate">${t.description}</div>
                            </div>
                        </a>
                    `).join('');
                }
                navDropdown.classList.remove('hidden');
            });

            document.addEventListener('click', (e) => {
                if (!navInput.contains(e.target) && !navDropdown.contains(e.target)) {
                    navDropdown.classList.add('hidden');
                }
            });
        }

        // Mobile Drawer Search Handler
        const mobInput = document.getElementById('mobileSearchInput');
        const mobResults = document.getElementById('mobileSearchResults');
        const categoryBlocks = document.querySelectorAll('.mobile-category-block');

        if (mobInput && mobResults) {
            mobInput.addEventListener('input', (e) => {
                const q = e.target.value.trim().toLowerCase();
                if (!q) {
                    mobResults.classList.add('hidden');
                    mobResults.innerHTML = '';
                    categoryBlocks.forEach(b => b.classList.remove('hidden'));
                    return;
                }

                categoryBlocks.forEach(b => b.classList.add('hidden'));

                const matches = allToolsData.filter(t => 
                    t.title.toLowerCase().includes(q) || 
                    t.description.toLowerCase().includes(q)
                );

                if (matches.length === 0) {
                    mobResults.innerHTML = '<div class="p-3 text-xs text-gray-500 dark:text-gray-400 text-center">No tools found</div>';
                } else {
                    mobResults.innerHTML = matches.map(t => `
                        <a href="${t.url}" class="flex items-center gap-2.5 p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
                            <span class="text-lg">${t.icon}</span>
                            <div class="overflow-hidden">
                                <div class="text-xs font-bold text-gray-900 dark:text-white truncate">${t.title}</div>
                                <div class="text-[11px] text-gray-500 dark:text-gray-400 truncate">${t.description}</div>
                            </div>
                        </a>
                    `).join('');
                }
                mobResults.classList.remove('hidden');
            });
        }

        // Mobile Drawer Toggle
        const mobileMenuBtn = document.getElementById('mobileMenuBtn');
        const mobileDrawer = document.getElementById('mobileDrawer');
        if (mobileMenuBtn && mobileDrawer) {
            mobileMenuBtn.addEventListener('click', () => {
                mobileDrawer.classList.toggle('hidden');
            });
        }

        // Dark Mode LocalStorage Toggle
        const themeToggleBtn = document.getElementById('themeToggleBtn');
        if (themeToggleBtn) {
            themeToggleBtn.addEventListener('click', () => {
                if (document.documentElement.classList.contains('dark')) {
                    document.documentElement.classList.remove('dark');
                    localStorage.setItem('theme', 'light');
                } else {
                    document.documentElement.classList.add('dark');
                    localStorage.setItem('theme', 'dark');
                }
            });
        }
    });
</script>